# 统一跨平台换行符规范：所有源码、配置与 Shell 脚本在仓库及检出时强制使用 LF
* text=auto eol=lf

*.mjs text eol=lf
*.cjs text eol=lf
*.js  text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.sh  text eol=lf

# Windows PowerShell 与批处理脚本保持 Windows 原生 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制归档
*.zip binary
